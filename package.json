{
  "name": "avk-workspace",
  "version": "1.0.0",
  "description": "AVK Workspace collaboration application",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/server.js\" \"cd client && npm run dev\"",
    "postinstall": "cd client && npm install && npm run build",
    "build": "cd client && npm run build",
    "desktop": "electron desktop/main.cjs",
    "build:exe": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.avk.workspace",
    "productName": "AVK Workspace",
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "desktop/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AVK Workspace",
      "artifactName": "AVK-Workspace-Setup.exe"
    },
    "portable": {
      "artifactName": "AVK-Workspace-Portable.exe"
    }
  },
  "keywords": [
    "slack",
    "sct",
    "chat",
    "coordination"
  ],
  "author": "AVK Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  }
}
